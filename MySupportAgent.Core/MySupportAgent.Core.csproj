<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Instructions\MainAgent.md" LogicalName="MySupportAgent.Core.Instructions.MainAgent.md" />
    <EmbeddedResource Include="Instructions\ResumeAgent.md" LogicalName="MySupportAgent.Core.Instructions.ResumeAgent.md" />
    <EmbeddedResource Include="Instructions\QuickNoteAgent.md" LogicalName="MySupportAgent.Core.Instructions.QuickNoteAgent.md" />
